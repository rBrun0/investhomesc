{
    "extends": ["next", "next/core-web-vitals", "prettier"],
    "plugins": ["prettier"],
    "rules": {
      "prettier/prettier": ["error"],
      "react/jsx-curly-brace-presence": ["error", { "props": "always", "children": "never" }],
      "react/self-closing-comp": "error",
      "no-unused-vars": "warn",
      "semi": ["error", "always"],
      "quotes": ["error", "double"]
    }
  }